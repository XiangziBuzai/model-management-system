# 环境变量模板
# 复制此文件为 .env.local 并填入实际值

# ===== Railway 后端环境变量 =====

# 数据库配置（Railway会自动注入MYSQL*变量，无需手动设置）
# SPRING_DATASOURCE_URL=jdbc:mysql://host:port/database?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_password

# JWT配置
JWT_SECRET=mySecretKeyForJWTTokenGenerationAndValidation123456789
JWT_EXPIRATION=86400000

# 文件上传配置
FILE_UPLOAD_PATH=/app/uploads/avatars
FILE_ACCESS_URL=https://your-backend-domain.railway.app/uploads

# ===== Vercel 前端环境变量 =====

# 后端API地址（在Vercel项目设置中配置）
# VITE_API_BASE_URL=https://your-backend-domain.railway.app/api
